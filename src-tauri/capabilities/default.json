{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Playlist",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$APPDATA/covers/**" },
        { "path": "$APPDATA/downloads/**" },
        { "path": "$APPDATA/music_videos/**" },
        { "path": "**" }
      ]
    },
    "fs:allow-write-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "shell:default",
    "shell:allow-spawn",
    "shell:allow-execute",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "window-state:default",
    "window-state:allow-restore-state",
    "window-state:allow-save-window-state",
    "core:tray:default"
  ]
}
