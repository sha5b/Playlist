{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Playlist",
  "version": "0.9.0",
  "identifier": "com.playlist.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "title": "Playlist",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://img.youtube.com; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "rpm", "deb", "dmg", "app"],
    "publisher": "sha5b",
    "copyright": "Copyright © 2025-2026 sha5b",
    "category": "Music",
    "shortDescription": "Liberate your music, own your data, support artists",
    "longDescription": "Playlist is a desktop music manager that liberates your music from streaming platforms. Download tracks from almost anywhere, discover missing albums and tracks for artists in your library, sync your collection across devices, and play everything locally with rich metadata from MusicBrainz and Last.fm — no subscriptions, no lock-in. Support artists directly by buying their music, not renting it.",
    "homepage": "https://github.com/sha5b/Playlist",
    "icon": [
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1", "libasound2"],
        "desktopTemplate": "resources/com.playlist.app.desktop",
        "postInstallScript": "scripts/postinstall.sh",
        "postRemoveScript": "scripts/postremove.sh",
        "files": {
          "/usr/share/metainfo/com.playlist.app.metainfo.xml": "resources/com.playlist.app.metainfo.xml",
          "/usr/share/icons/hicolor/32x32/apps/com.playlist.app.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/48x48/apps/com.playlist.app.png": "icons/48x48.png",
          "/usr/share/icons/hicolor/64x64/apps/com.playlist.app.png": "icons/64x64.png",
          "/usr/share/icons/hicolor/128x128/apps/com.playlist.app.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/com.playlist.app.png": "icons/256x256.png",
          "/usr/share/icons/hicolor/512x512/apps/com.playlist.app.png": "icons/icon.png",
          "/usr/share/icons/hicolor/scalable/apps/com.playlist.app.svg": "icons/com.playlist.app.svg"
        }
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3", "libappindicator-gtk3", "alsa-lib"],
        "desktopTemplate": "resources/com.playlist.app.desktop",
        "postInstallScript": "scripts/postinstall.sh",
        "postRemoveScript": "scripts/postremove.sh",
        "files": {
          "/usr/share/metainfo/com.playlist.app.metainfo.xml": "resources/com.playlist.app.metainfo.xml",
          "/usr/share/icons/hicolor/32x32/apps/com.playlist.app.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/48x48/apps/com.playlist.app.png": "icons/48x48.png",
          "/usr/share/icons/hicolor/64x64/apps/com.playlist.app.png": "icons/64x64.png",
          "/usr/share/icons/hicolor/128x128/apps/com.playlist.app.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/com.playlist.app.png": "icons/256x256.png",
          "/usr/share/icons/hicolor/512x512/apps/com.playlist.app.png": "icons/icon.png",
          "/usr/share/icons/hicolor/scalable/apps/com.playlist.app.svg": "icons/com.playlist.app.svg"
        }
      }
    }
  }
}
