		"@tauri-apps/cli": "^2.10.1",
		"@types/node": "^25.5.0",
		"bits-ui": "^2.16.5",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"tailwind-variants": "^3.2.2",
