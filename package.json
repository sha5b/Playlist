	"version": "0.9.0",
	"description": "Liberate your music. Own your data. Support artists. Download tracks, discover missing music, sync across devices, and play everything locally.",
	"author": "sha5b",
	"license": "MIT",
	"repository": "https://github.com/sha5b/Playlist",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
